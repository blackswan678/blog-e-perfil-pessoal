/* RESET E ESTILOS GERAIS */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    background-color: #f4f4f9;
    color: #333333;
    transition: background-color 0.3s, color 0.3s;
}

/* ESTILO DO CABEÇALHO */
header {
    padding: 60px;
    text-align: center;
    background-color: #1abc9c;
    color: #ffffff;
}

/* ESTILO DA BARRA DE NAVEGAÇÃO */
nav {
    display: flex;
    background-color: #333333;
    align-items: center;
}

nav a {
    color: #ffffff;
    padding: 14px 20px;
    text-decoration: none;
    text-align: center;
}

nav a:hover {
    background-color: #dddddd;
    color: #000000;
}

.nav-btn {
    margin-left: auto;
    margin-right: 20px;
    padding: 8px 16px;
    background-color: #1abc9c;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
}

.nav-btn:hover {
    background-color: #16a085;
}

/* LAYOUT DE COLUNAS (FLEXBOX) */
.row {
    display: flex;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 20px auto;
    padding: 0 10px;
}

/* BARRA LATERAL (ASIDE - SOBRE MIM) */
aside {
    flex: 30%;
    background-color: #f1f1f1;
    padding: 20px;
    border-radius: 8px;
}

aside h2, aside h5 {
    margin-top: 15px;
    margin-bottom: 8px;
}

aside ul, aside ol {
    margin-left: 20px;
    margin-bottom: 15px;
}

.social-links a {
    display: inline-block;
    margin-right: 10px;
    color: #1abc9c;
    text-decoration: none;
    font-weight: bold;
}

.social-links a:hover {
    text-decoration: underline;
}

/* CONTEÚDO PRINCIPAL (MAIN - POSTAGENS) */
main {
    flex: 70%;
    padding: 0 0 0 20px;
}

.card {
    background-color: #ffffff;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.card h2 {
    color: #333333;
}

.card h5 {
    color: #777777;
    margin-bottom: 15px;
}

/* CLASSE DE IMAGEM FICTÍCIA */
.fakeimg {
    background-color: #aaaaaa;
    width: 100%;
    padding: 20px;
    margin-bottom: 10px;
    color: #ffffff;
    font-weight: bold;
    border-radius: 4px;
}

/* BOTÃO DE CURTIR */
.btn-curtir {
    background-color: #e74c3c;
    color: #ffffff;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9rem;
    margin-top: 10px;
    transition: transform 0.1s ease;
}

.btn-curtir:active {
    transform: scale(0.95);
}

/* RODAPÉ */
footer {
    padding: 20px;
    text-align: center;
    background-color: #dddddd;
    margin-top: 20px;
}

/* REGRA DO MODO ESCURO */
body.dark-mode {
    background-color: #1a1a1a;
    color: #f4f4f9;
}

body.dark-mode aside {
    background-color: #2a2a2a;
}

body.dark-mode .card {
    background-color: #2a2a2a;
    color: #ffffff;
}

body.dark-mode .card h2 {
    color: #1abc9c;
}

body.dark-mode .card h5 {
    color: #bbb;
}

body.dark-mode footer {
    background-color: #111;
    color: #aaa;
}

/* RESPONSIVIDADE PARA DISPOSITIVOS MÓVEIS */
@media screen and (max-width: 700px) {
    .row {
        flex-direction: column;
    }
    
    main {
        padding: 20px 0 0 0;
    }

    nav {
        flex-direction: column;
    }

    .nav-btn {
        margin: 10px auto;
    }
}

document.addEventListener("DOMContentLoaded", () => {
    
    // 1. CONTADOR DE CURTIDAS NAS POSTAGENS
    const botoesCurtir = document.querySelectorAll(".btn-curtir");

    botoesCurtir.forEach((botao) => {
        let contador = 0;
        const contadorSpan = botao.querySelector(".count");

        botao.addEventListener("click", () => {
            contador++;
            contadorSpan.textContent = contador;
        });
    });

    // 2. ALTERNÂNCIA DE TEMA (MODO CLARO / ESCURO)
    const btnTema = document.getElementById("btn-tema");

    btnTema.addEventListener("click", () => {
        document.body.classList.toggle("dark-mode");

        if (document.body.classList.contains("dark-mode")) {
            btnTema.textContent = "Modo Claro";
        } else {
            btnTema.textContent = "Modo Escuro";
        }
    });

});
