<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orkut :: Perfil de Izabella Suan</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --purple-dark: #4a235a;
            --purple-header: #5b2c6f;
            --purple-main: #7d3c98;
            --purple-light: #af7ac5;
            --lilac-bg: #f4ecf7;
            --lilac-card: #ffffff;
            --lilac-border: #d2b4de;
            --lilac-hover: #ebdef0;
            --text-color: #2c3e50;
            --text-muted: #7f8c8d;
            --pink-accent: #e056fd;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Tahoma, Verdana, Arial, sans-serif; font-size: 12px; background-color: var(--lilac-bg); color: var(--text-color); line-height: 1.5; }
        a { color: var(--purple-main); text-decoration: none; }
        a:hover { text-decoration: underline; }

        .orkut-header { background: linear-gradient(180deg, #6c3483 0%, #512e5f 100%); border-bottom: 2px solid #3b1847; color: #ffffff; padding: 6px 0; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .header-container { max-width: 980px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; }
        .logo { font-size: 20px; font-weight: bold; font-family: Arial, sans-serif; letter-spacing: -1px; }
        .logo-orkut { color: #ebdef0; }
        .logo-purple { color: #e056fd; font-size: 13px; font-weight: normal; }
        .top-nav { display: flex; gap: 15px; }
        .top-nav a { color: #f5eea0; font-weight: bold; font-size: 11px; }
        .top-nav a.active, .top-nav a:hover { color: #ffffff; text-shadow: 0 0 4px #e056fd; }
        .search-box { display: flex; align-items: center; }
        .search-box input { padding: 3px 6px; font-size: 11px; border: 1px solid var(--purple-dark); border-radius: 2px 0 0 2px; outline: none; }
        .search-box button { background-color: var(--purple-main); color: #fff; border: 1px solid var(--purple-dark); padding: 3px 8px; cursor: pointer; border-radius: 0 2px 2px 0; }

        .main-container { max-width: 980px; margin: 15px auto; display: flex; gap: 15px; padding: 0 10px; }
        .left-column { width: 280px; display: flex; flex-direction: column; gap: 12px; }
        .right-column { flex: 1; display: flex; flex-direction: column; gap: 12px; }
        .card { background-color: var(--lilac-card); border: 1px solid var(--lilac-border); border-radius: 4px; padding: 12px; box-shadow: 1px 1px 3px rgba(125, 60, 152, 0.1); }

        .profile-box { text-align: center; background-color: #fcf8ff; }
        .avatar-frame { border: 3px solid var(--lilac-border); padding: 3px; background-color: #fff; border-radius: 4px; display: inline-block; }
        .profile-pic { width: 180px; height: 180px; object-fit: cover; display: block; border-radius: 2px; }
        .profile-name { font-size: 15px; color: var(--purple-dark); margin-top: 8px; }
        .purple-heart { color: var(--pink-accent); }
        .profile-status { font-style: italic; color: var(--purple-main); font-size: 11px; margin: 6px 0; }
        .profile-details-mini { text-align: left; background-color: var(--lilac-hover); padding: 8px; border-radius: 4px; margin: 8px 0; font-size: 11px; }
        .profile-details-mini p { margin-bottom: 4px; }

        .orkut-ratings { text-align: left; margin: 10px 0; padding: 6px; border-top: 1px dashed var(--lilac-border); border-bottom: 1px dashed var(--lilac-border); }
        .rating-item { display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px; }
        .rating-item .label { font-weight: bold; color: var(--purple-dark); }

        .action-buttons { display: flex; gap: 6px; margin-top: 8px; }
        .btn-orkut { flex: 1; background: linear-gradient(180deg, #af7ac5 0%, #7d3c98 100%); color: #ffffff; border: 1px solid var(--purple-dark); padding: 6px; font-size: 11px; font-weight: bold; border-radius: 3px; cursor: pointer; text-align: center; }
        .btn-orkut:hover { background: linear-gradient(180deg, #c39bd3 0%, #8e44ad 100%); }
        .btn-subtle { background: var(--lilac-hover); border: 1px solid var(--lilac-border); color: var(--purple-dark); padding: 4px 8px; font-size: 10px; border-radius: 3px; cursor: pointer; }

        .grid-box .box-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--lilac-border); padding-bottom: 4px; margin-bottom: 8px; }
        .grid-box h3 { font-size: 12px; color: var(--purple-dark); }
        .thumb-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
        .thumb-item { text-align: center; }
        .thumb-item img { width: 60px; height: 60px; object-fit: cover; border: 1px solid var(--lilac-border); border-radius: 3px; display: block; margin: 0 auto 3px auto; }
        .thumb-item .comm-icon { width: 60px; height: 60px; background-color: var(--lilac-hover); border: 1px solid var(--lilac-border); border-radius: 3px; display: flex; align-items: center; justify-content: center; margin: 0 auto 3px auto; font-size: 20px; color: var(--purple-main); }
        .thumb-item span { display: block; font-size: 10px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 70px; }

        .fortune-card { background-color: #fdf6ff; border-left: 4px solid var(--purple-main); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .fortune-title { color: var(--purple-dark); font-size: 12px; }
        #fortune-text { font-style: italic; color: #555; flex: 1; }

        .orkut-tabs { display: flex; border-bottom: 2px solid var(--purple-main); gap: 3px; }
        .tab-btn { background-color: #e8daef; border: 1px solid var(--lilac-border); border-bottom: none; padding: 7px 14px; font-size: 11px; font-weight: bold; color: var(--purple-dark); cursor: pointer; border-radius: 4px 4px 0 0; }
        .tab-btn.active { background-color: var(--purple-main); color: #ffffff; border-color: var(--purple-main); }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .bio-card h3 { color: var(--purple-dark); border-bottom: 1px solid var(--lilac-border); padding-bottom: 4px; margin-bottom: 8px; font-size: 13px; }
        .bio-text p { margin-bottom: 8px; font-size: 12px; }
        .divider { border: 0; height: 1px; background-color: var(--lilac-border); margin: 15px 0; }
        .orkut-table { width: 100%; border-collapse: collapse; }
        .orkut-table td { padding: 6px; border-bottom: 1px dotted var(--lilac-border); vertical-align: top; }
        .td-label { width: 120px; font-weight: bold; color: var(--purple-dark); background-color: #fbf5fc; }

        .scrap-form { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
        .scrap-form input, .scrap-form textarea { padding: 6px; border: 1px solid var(--lilac-border); border-radius: 3px; font-family: inherit; font-size: 11px; }
        .scrap-post { border-bottom: 1px solid var(--lilac-border); padding: 10px 0; }
        .scrap-author { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
        .scrap-author img { width: 35px; height: 35px; border-radius: 3px; border: 1px solid var(--lilac-border); }
        .scrap-date { font-size: 10px; color: var(--text-muted); margin-left: 5px; }
        .scrap-body { background-color: #fcf8ff; padding: 8px; border-radius: 4px; border-left: 3px solid var(--purple-light); }

        .depo-notice { background-color: #fef9e7; border: 1px solid #f9e79f; padding: 6px; border-radius: 3px; margin-bottom: 10px; color: #7d6608; text-align: center; }
        .testimonial-box { background-color: #fbf5fc; border: 1px solid var(--lilac-border); padding: 10px; border-radius: 4px; margin-bottom: 10px; }
        .testimonial-header { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
        .testimonial-header img { width: 40px; height: 40px; border-radius: 3px; }
        .testimonial-text { font-style: italic; line-height: 1.6; }

        .blog-post { margin-bottom: 12px; }
        .blog-meta { display: flex; justify-content: space-between; font-size: 10px; color: var(--text-muted); margin-bottom: 6px; }
        .blog-post h2 { color: var(--purple-dark); font-size: 15px; margin-bottom: 8px; }
        .blog-excerpt { font-weight: bold; color: var(--purple-main); margin-bottom: 6px; }
        .blog-post p { margin-bottom: 8px; font-size: 12px; }
        .blog-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 6px; border-top: 1px dotted var(--lilac-border); font-size: 11px; }
        .post-likes { color: var(--pink-accent); font-weight: bold; }

        .orkut-footer { text-align: center; padding: 15px; background-color: #4a235a; color: #d2b4de; font-size: 11px; margin-top: 20px; border-top: 2px solid var(--purple-main); }

        @media screen and (max-width: 768px) {
            .main-container { flex-direction: column; }
            .left-column { width: 100%; }
            .header-container { flex-direction: column; gap: 8px; }
            .orkut-tabs { overflow-x: auto; }
            .fortune-card { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
